# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is already covered by .gitignore.

# ---------------------------------------------------------------------------
# Database (server-only)
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime (src/lib/db.ts).
# With `docker compose up -d` the bundled compose file exposes a matching
# local database out of the box.
DATABASE_URL="postgresql://covenant:covenant@localhost:5432/covenant_tcg_portal"

# Connection string used only by the Prisma CLI (migrate/generate/studio),
# via prisma.config.ts — must be a SESSION-capable connection, not a
# transaction-mode pooler (migrations need an advisory lock and prepared
# statements a transaction pooler can't provide). For a single local
# Postgres instance this is identical to DATABASE_URL; they only need to
# differ against a pooled provider like Supabase — see
# docs/DEPLOYMENT.md#vercel-specifically.
DIRECT_URL="postgresql://covenant:covenant@localhost:5432/covenant_tcg_portal"

# ---------------------------------------------------------------------------
# Session security (server-only)
# ---------------------------------------------------------------------------
# Used to derive the HMAC that signs session cookies and to hash
# verification/reset tokens before they're stored. Generate a strong random
# value, e.g.: `openssl rand -hex 32`
AUTH_SECRET="replace-with-openssl-rand--hex-32-output"

# Public base URL of this deployment. Used to build absolute links in
# verification/password-reset emails. No trailing slash.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Outbound email (server-only)
# ---------------------------------------------------------------------------
# SMTP credentials for sending verification and password-reset emails.
# If left unset in development, emails are logged to the server console
# instead of being sent (see src/lib/email.ts) — never rely on this in
# production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Address emails are sent from, e.g. "Covenant TCG <no-reply@example.com>"
SMTP_FROM="Covenant TCG <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Google sign-in (server-only, optional)
# ---------------------------------------------------------------------------
# Leave both unset to disable Google sign-in entirely — the "Continue with
# Google" button is hidden and /api/auth/google/* returns 501. To enable:
# 1. In Google Cloud Console, create an OAuth 2.0 Client ID (Web application)
#    under APIs & Services > Credentials.
# 2. Add this exact Authorized redirect URI: <APP_URL>/api/auth/google/callback
#    (must match APP_URL above exactly, including scheme — no trailing slash).
# 3. Copy the generated Client ID and Client Secret below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Game integration (server-only)
# ---------------------------------------------------------------------------
# Shared secret the (future) game server presents as a Bearer token to call
# the /api/game/* endpoints (submit match results, look up profiles). This
# must never be embedded in a game client — only in a trusted game server.
# Generate with: `openssl rand -hex 32`
GAME_SERVER_API_KEY="replace-with-openssl-rand--hex-32-output"

# The game client's own origin (e.g. "https://thecovenant.game"), allowed
# to call /api/game/auth/* and /api/game/save via CORS (src/lib/cors.ts).
# Unlike GAME_SERVER_API_KEY above, these routes are called directly from
# a player's browser running the game, not from a trusted backend, so they
# need this instead of (or as well as) a shared secret. Leave unset to
# reject all cross-origin requests to those routes.
GAME_CLIENT_ORIGIN=""

# ---------------------------------------------------------------------------
# Client-safe values (exposed to the browser — no secrets here)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Covenant"
